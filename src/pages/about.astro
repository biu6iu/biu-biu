---
import Layout from '../layouts/Layout.astro';
import TimelineEntry from '../components/TimelineEntry.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SectionLink from '../components/SectionLink.astro';
import { EDUCATION, EXPERIENCE, EXTRACURRICULARS } from '../data/about.ts';

const base = import.meta.env.BASE_URL;
---

<Layout title="About me">
  <section class="max-w-200 mx-auto p-8 box-border">
    <div class="mb-12">
      <SectionHeading>About</SectionHeading>
      <p>Hi, my name is Steven!</p>
      <p>I'm an undergrad at the University of Melbourne, studying computing and maths.</p>
      <p>I'm interested in machine learning and enjoy building models to understand real-world data.</p>
      <p>Outside of coding, I like to take photos, play basketball and appreciate cars.</p>
      <p>I also enjoy watching movies and listening to all sorts of music, so go judge my <a href="https://letterboxd.com/6iubiu/" target="_blank" rel="noopener noreferrer">Letterboxd</a> and <a href="https://www.last.fm/user/biubiuuu" target="_blank" rel="noopener noreferrer">last.fm</a> if you want :D</p>
    </div>

    <div class="mb-12">
      <SectionHeading>Education</SectionHeading>
      <div class="border-t border-ink">
        {EDUCATION.map((entry) => <TimelineEntry entry={entry} />)}
      </div>
    </div>

    <div class="mb-12">
      <SectionHeading>Experience</SectionHeading>
      <div class="border-t border-ink">
        {EXPERIENCE.map((entry) => <TimelineEntry entry={entry} />)}
      </div>
    </div>

    <div class="mb-12">
      <SectionHeading>Extracurriculars</SectionHeading>
      <div class="border-t border-ink">
        {EXTRACURRICULARS.map((entry) => <TimelineEntry entry={entry} bulleted />)}
      </div>
    </div>

    <div class="mb-12">
      <SectionHeading>Skills</SectionHeading>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] max-md:grid-cols-[1fr] gap-8 pt-6 border-t border-ink">
        <div class="mb-6">
          <h3 class="text-[1.2rem] mb-2 font-medium">Programming</h3>
          <p class="text-ink-body leading-[1.6]">Python, Java, C, C++, R, SQL</p>
        </div>
        <div class="mb-6">
          <h3 class="text-[1.2rem] mb-2 font-medium">Tools/Frameworks</h3>
          <p class="text-ink-body leading-[1.6]">Git, FastAPI, Pandas, NumPy, sklearn, PyTorch, MatPlotLib, Seaborn</p>
        </div>
      </div>
    </div>

    <div class="mb-12">
      <p>Since you've scrolled this far, you might as well check out the <SectionLink href={`${base}photography`} text="photography page" /></p>
    </div>
  </section>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';
import { GALLERIES } from '../../data/galleries.ts';
import { COLLECTIONS, collectionSlug } from '../../data/collections.ts';

export function getStaticPaths() {
  return GALLERIES.map((gallery) => ({
    params: { slug: gallery.slug },
    props: { gallery },
  }));
}

const { gallery } = Astro.props;

const collection = COLLECTIONS.find((c) => collectionSlug(c) === gallery.slug);

const pageTitle = collection?.title ?? gallery.slug
  .split('_')
  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
  .join(' ');
---

<Layout
  title={pageTitle}
  description={`${pageTitle}: a photography collection by Steven Lu.`}
  image={gallery.images[0]?.src}
>
  <div class="w-full h-full">
    <Gallery gallery={gallery} />
  </div>
</Layout>

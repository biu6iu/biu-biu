---
import Layout from '../../layouts/Layout.astro';
import Page from '../../components/Page.astro';
import BackLink from '../../components/BackLink.astro';
import SectionLink from '../../components/SectionLink.astro';
import { PROJECTS } from '../../data/projects.ts';

export function getStaticPaths() {
  return PROJECTS.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Layout title={project.title} description={project.summary}>
  <Page>
    <p class="mb-6">
      <BackLink href={`${base}projects`}>Projects</BackLink>
    </p>

    <h2 class="text-[18px] max-md:text-[16px] font-normal uppercase">{project.title}</h2>
    <p class="text-ink-muted mt-2 mb-6">{project.summary}</p>

    <div class="border-t border-ink pt-6">
      {project.bullets.map((bullet) => <p> • {bullet}</p>)}

      <div class="mt-6 flex flex-col gap-4">
        {project.links.map((link) => (
          <div>
            <p class="text-ink-soft text-[15px]">{link.label.replace(/:$/, '')}</p>
            <p class="mt-1"><SectionLink href={link.href} text={link.text} /></p>
          </div>
        ))}
      </div>
    </div>
  </Page>
</Layout>

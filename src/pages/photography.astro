---
import Layout from '../layouts/Layout.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { GALLERIES } from '../data/galleries.ts';

const base = import.meta.env.BASE_URL;

// Each collection's cover is the first photo of its gallery
const covers = GALLERIES.map(({ slug, collectionTitle, images: [cover] }) => ({
  src: cover.src,
  alt: collectionTitle,
  width: cover.width,
  height: cover.height,
  href: `${base}collections/${slug}`,
  caption: collectionTitle,
}));
---

<Layout title="Collections" description="Photography collections by Steven Lu: Sydney, Melbourne, China, New Zealand and film archives.">
  <!-- Full width, so covers are the same size and position as the photos on each collection page -->
  <PhotoStrip items={covers} label="Collections">
    <section class="max-w-200 mx-auto px-8 pt-8 box-border">
      <SectionHeading>Collections</SectionHeading>
    </section>

    <!-- Desktop only, and gone once the nav is collapsed since there's nothing left to suggest -->
    <p slot="after" class="max-md:hidden md:nav-collapsed:hidden m-0 mt-6 text-center text-sm text-ink-muted">
      Tip: hide the sidebar with the arrow on its edge for a bigger view.
    </p>
  </PhotoStrip>
</Layout>

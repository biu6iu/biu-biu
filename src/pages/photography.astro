---
import Layout from '../layouts/Layout.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { COLLECTIONS, collectionSlug } from '../data/collections.ts';

const base = import.meta.env.BASE_URL;

const covers = COLLECTIONS.map((collection) => ({
  src: collection.coverImage,
  alt: collection.title,
  width: collection.coverWidth,
  height: collection.coverHeight,
  href: `${base}collections/${collectionSlug(collection)}`,
  caption: collection.title,
}));
---

<Layout title="Photography" description="Photography collections by Steven Lu: Sydney, Melbourne, China, New Zealand and film archives.">
  <!-- Full width, so covers are the same size and position as the photos on each collection page -->
  <PhotoStrip items={covers} label="Collections">
    <section class="max-w-200 mx-auto px-8 pt-8 box-border">
      <SectionHeading>Collections</SectionHeading>
    </section>
  </PhotoStrip>
</Layout>

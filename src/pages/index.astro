---
import Layout from '../layouts/Layout.astro';
import { COLLECTIONS } from '../data/collections.ts';


const SLIDE_INTERVAL = 2500;
---

<Layout>
  <div
    id="photo-slideshow"
    class="relative w-full h-full flex justify-center items-center overflow-hidden"
    data-interval={SLIDE_INTERVAL}
  >
    {COLLECTIONS.map((collection, i) => (
      <img
        src={collection.coverImage}
        alt={collection.title}
        class:list={[
          'absolute max-w-[75%] max-h-[75svh] object-contain',
          'transition-opacity duration-1000 ease-[ease-in-out]',
          i === 0 ? 'opacity-100' : 'opacity-0',
        ]}
        aria-hidden={i === 0 ? undefined : 'true'}
      />
    ))}
  </div>
</Layout>

<script>
  const slideshow = document.getElementById('photo-slideshow');

  if (slideshow) {
    const images = Array.from(slideshow.getElementsByTagName('img'));
    const interval = Number(slideshow.dataset.interval) || 2500;
    let current = 0;

    let timer: number | undefined;

    const show = (next: number) => {
      images[current].classList.replace('opacity-100', 'opacity-0');
      images[current].setAttribute('aria-hidden', 'true');
      current = next;
      images[current].classList.replace('opacity-0', 'opacity-100');
      images[current].removeAttribute('aria-hidden');
    };

    const start = () => {
      clearInterval(timer);
      timer = window.setInterval(() => show((current + 1) % images.length), interval);
    };

    // Auto-advancing content is motion, so reduced-motion visitors get the first photo only
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (images.length > 1 && !reduceMotion) {
      start();
      // Don't keep cycling in a background tab
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) clearInterval(timer);
        else start();
      });
    }
  }
</script>

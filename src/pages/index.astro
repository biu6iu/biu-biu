---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Graham scan drawn in ASCII on a loop (src/lib/graham.ts): random points, then their convex hull -->
  <div id="hull" class="w-full h-full flex flex-col justify-center items-center gap-4">
    <canvas
      id="hull-canvas"
      role="img"
      aria-label="An animation of the Graham scan algorithm finding the convex hull of random points, drawn in ASCII characters"
      class="transition-opacity duration-500"
    ></canvas>
    <p class="m-0 text-sm text-ink-muted text-center">graham scan</p>
  </div>
</Layout>

<script>
  import { grahamScan, randomPoints, type Point } from '../lib/graham.ts';

  // The grid is GRID × GRID cells, each two characters wide so a cell comes out roughly square
  const GRID = 50;
  const MIN_POINTS = 10;
  const MAX_POINTS = 30;
  const MONO_FONT = 'ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace';

  // Milliseconds for each beat of the animation
  const TIMING = {
    spawn: 40, // between points appearing
    pivot: 600,
    sweep: 80, // per point as the ray sweeps round them in angle order
    check: 170,
    pop: 200,
    push: 120,
    done: 3000, // the finished hull, before it fades
    fade: 500,
  };

  const container = document.getElementById('hull')!;
  const canvas = document.getElementById('hull-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
  // Waits that don't count time spent in a background tab
  const visibleSleep = async (ms: number) => {
    await sleep(ms);
    while (document.hidden) {
      await new Promise((resolve) => document.addEventListener('visibilitychange', resolve, { once: true }));
    }
  };

  // ---- What's on screen ----

  type Tone = 'faint' | 'muted' | 'ink';
  interface Scene {
    points: Point[];
    pivot: Point | null;
    ray: Point | null; // the sweep, from the pivot
    candidate: [Point, Point] | null; // the edge being tested
    stack: Point[]; // consecutive stack points are joined by solid edges
    hull: Point[] | null; // set once finished
  }
  const emptyScene = (): Scene => ({ points: [], pivot: null, ray: null, candidate: null, stack: [], hull: null });
  let scene = emptyScene();

  // ---- Layout: the biggest character size that fits (75% of the screen tall, 90% of the area wide) ----

  let glyphWidth = 0;
  let lineHeight = 0;
  const fit = () => {
    const probe = document.createElement('canvas').getContext('2d')!;
    probe.font = `100px ${MONO_FONT}`;
    const aspect = probe.measureText('M').width / 100;

    const columns = GRID * 2;
    const fontSize = Math.min((window.innerHeight * 0.75) / GRID, (container.clientWidth * 0.9) / (columns * aspect));
    glyphWidth = fontSize * aspect;
    lineHeight = fontSize;

    const width = columns * glyphWidth;
    const height = GRID * lineHeight;
    const dpr = Math.min(window.devicePixelRatio || 1, 3);
    canvas.width = Math.round(width * dpr);
    canvas.height = Math.round(height * dpr);
    canvas.style.width = `${width}px`;
    canvas.style.height = `${height}px`;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.font = `${fontSize}px ${MONO_FONT}`;
    ctx.textBaseline = 'top';
  };

  // ---- Drawing ----

  /** The character grid: GRID rows of GRID * 2 columns. Row 0 is the top, so y (which points up) is flipped. */
  const blankGrid = () =>
    Array.from({ length: GRID }, () =>
      Array.from({ length: GRID * 2 }, (_, col) => ({ ch: col % 2 === 0 ? '·' : ' ', tone: 'faint' as Tone })),
    );
  type Grid = ReturnType<typeof blankGrid>;

  const put = (grid: Grid, p: Point, ch: string, tone: Tone) => {
    grid[GRID - 1 - p.y][p.x * 2] = { ch, tone };
  };

  /**
   * A line from a to b (ends excluded), sampled on the character grid itself rather than on cells.
   * Steep lines get one character per row (| or a slash), so they never double up or jog sideways.
   * Shallow lines get one per column, and ‾ - _ give three heights within a row, so they slope smoothly
   * instead of stepping in runs of -.
   */
  const line = (grid: Grid, a: Point, b: Point, tone: Tone) => {
    // Character coordinates: each point sits on the first column of its cell, and rows count downwards
    const c0 = a.x * 2;
    const c1 = b.x * 2;
    const r0 = GRID - 1 - a.y;
    const r1 = GRID - 1 - b.y;
    const dc = c1 - c0;
    const dr = r1 - r0;
    // Slope as it looks on screen, where a character is narrower than it is tall
    const angle = Math.atan2(Math.abs(dr) * lineHeight, Math.abs(dc) * glyphWidth);
    const set = (row: number, col: number, ch: string) => (grid[row][col] = { ch, tone });

    if (angle >= Math.PI / 4) {
      // Up the screen and to the right is /, since rows count downwards
      const ch = angle > (3 * Math.PI) / 8 ? '|' : dc * dr < 0 ? '/' : '\\';
      const step = Math.sign(dr);
      for (let row = r0 + step; row !== r1; row += step) set(row, Math.round(c0 + ((row - r0) * dc) / dr), ch);
    } else {
      const step = Math.sign(dc);
      for (let col = c0 + step; col !== c1; col += step) {
        const exact = r0 + ((col - c0) * dr) / dc;
        const row = Math.round(exact);
        // Where in its row the line passes: the top third, the middle or the bottom third
        const offset = exact - row;
        set(row, col, offset < -1 / 6 ? '‾' : offset > 1 / 6 ? '_' : '-');
      }
    }
  };

  const render = () => {
    const grid = blankGrid();

    if (scene.ray && scene.pivot) line(grid, scene.pivot, scene.ray, 'muted');
    if (scene.candidate) line(grid, scene.candidate[0], scene.candidate[1], 'muted');
    const path = scene.hull ? [...scene.hull, scene.hull[0]] : scene.stack;
    for (let i = 0; i + 1 < path.length; i++) line(grid, path[i], path[i + 1], 'ink');

    const onHull = new Set(scene.hull ?? scene.stack);
    for (const p of scene.points) {
      if (p === scene.pivot) put(grid, p, '@', 'ink');
      else if (onHull.has(p)) put(grid, p, 'O', 'ink');
      else put(grid, p, 'o', scene.hull ? 'muted' : 'ink'); // inside the finished hull, they recede
    }

    const tokens = getComputedStyle(document.documentElement);
    const colours: Record<Tone, string> = {
      ink: tokens.getPropertyValue('--text-primary').trim() || '#000',
      muted: tokens.getPropertyValue('--text-muted').trim() || '#707070',
      faint: tokens.getPropertyValue('--border').trim() || '#e0e0e0',
    };

    ctx.clearRect(0, 0, canvas.width, canvas.height);
    grid.forEach((row, r) =>
      row.forEach((cell, c) => {
        if (cell.ch === ' ') return;
        ctx.fillStyle = colours[cell.tone];
        ctx.fillText(cell.ch, c * glyphWidth, r * lineHeight);
      }),
    );
  };

  // ---- One run of the algorithm ----

  const run = async (animate: boolean) => {
    const count = MIN_POINTS + Math.floor(Math.random() * (MAX_POINTS - MIN_POINTS + 1));
    const points = randomPoints(count, GRID);
    const { pivot, sorted, steps, hull } = grahamScan(points);
    scene = emptyScene();

    if (!animate) {
      scene = { ...scene, points, pivot, hull };
      render();
      return;
    }

    for (const p of points) {
      scene.points.push(p);
      render();
      await visibleSleep(TIMING.spawn);
    }

    scene.pivot = pivot;
    render();
    await visibleSleep(TIMING.pivot);

    for (const p of sorted) {
      scene.ray = p;
      render();
      await visibleSleep(TIMING.sweep);
    }
    scene.ray = null;

    scene.stack = [pivot];
    for (const step of steps) {
      if (step.kind === 'check') {
        scene.candidate = [step.from, step.to];
        render();
        await visibleSleep(TIMING.check);
      } else if (step.kind === 'pop') {
        // A right turn: the last edge comes off the stack
        scene.stack.pop();
        scene.candidate = null;
        render();
        await visibleSleep(TIMING.pop);
      } else {
        scene.stack.push(step.point);
        scene.candidate = null;
        render();
        await visibleSleep(TIMING.push);
      }
    }

    scene.hull = hull;
    render();
    await visibleSleep(TIMING.done);
  };

  fit();
  window.addEventListener('resize', () => {
    fit();
    render();
  });
  // Redraw in the new colours when the theme changes (other classes on <html> change too, so check)
  let wasDark = document.documentElement.classList.contains('dark-mode');
  new MutationObserver(() => {
    const dark = document.documentElement.classList.contains('dark-mode');
    if (dark === wasDark) return;
    wasDark = dark;
    render();
  }).observe(document.documentElement, { attributeFilter: ['class'] });

  const loop = async () => {
    // Reduced motion: one finished hull, no animation
    if (reduceMotion) return run(false);
    while (true) {
      await run(true);
      canvas.classList.add('opacity-0');
      await visibleSleep(TIMING.fade);
      scene = emptyScene();
      render();
      canvas.classList.remove('opacity-0');
    }
  };
  loop();
</script>

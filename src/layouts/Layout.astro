---
import Nav from '../components/Nav.astro';
import '../styles/global.css';

import { COLLECTIONS } from '../data/collections.ts';

interface Props {
  /** Page name; " · Steven Lu" is appended. Omit on the home page. */
  title?: string;
  description?: string;
  /** Absolute URL for link previews; defaults to the first collection cover. */
  image?: string;
}

const SITE_NAME = 'Steven Lu';
const SOURCE_URL = 'https://github.com/biu6iu/biu-biu';

const {
  title,
  description = "Steven's personal website. Computing and maths student at the University of Melbourne, interested in machine learning. Projects, photography and more.",
  image = COLLECTIONS[0].coverImage,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
const canonical = new URL(Astro.url.pathname, Astro.site);

const mainClass = 'flex-1 flex flex-col overflow-y-auto h-dvh max-md:h-auto max-md:min-h-0 box-border p-5';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500&display=swap" />
    <script is:inline>
      // localStorage can throw when site data is blocked
      try {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.classList.add('dark-mode');
        }
        if (localStorage.getItem('nav') === 'collapsed') {
          document.documentElement.classList.add('nav-collapsed');
        }
      } catch (e) {}
    </script>
  </head>
  <body class="m-0 p-0 font-serif text-ink bg-page flex h-dvh">
    <div class="flex max-md:flex-col w-full min-h-dvh max-md:h-auto overflow-hidden">
      <Nav />
      <main class={mainClass}>
        <!-- Grows to fill the main area, so pages sized with h-full still fill it and the footer stays at the bottom -->
        <div class="flex-[1_0_auto]">
          <slot />
        </div>
        <footer class="shrink-0 pt-4 text-right max-md:text-center text-ink-muted">
          <p class="m-0 text-xs">
            &copy; {year} {SITE_NAME} · Photos are my own, please ask before reusing them ·
          </p>
        </footer>
      </main>
    </div>

    <script>
      // Scroll reveal for [data-reveal] elements (styles in global.css). Only elements that start
      // below the fold (or photos still loading) are hidden, so loaded content never flashes and
      // nothing is hidden without JS.
      const STAGGER_MS = 60;
      const DURATION_MS = 500;

      const items = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));

      const reveal = (el: HTMLElement, delay: number) => {
        el.style.transitionDelay = `${delay}ms`;
        el.classList.add('reveal-in');
        getComputedStyle(el).opacity; // commit the hidden state so the change below transitions
        el.classList.remove('reveal-pending');

        // Hand the element's own transitions back once the reveal is done
        window.setTimeout(() => {
          el.classList.remove('reveal-in');
          el.style.transitionDelay = '';
        }, DURATION_MS + delay + 50);
      };

      if ('IntersectionObserver' in window && items.length) {
        // Below the fold, or a photo that hasn't loaded yet (it has no height, so its position means nothing)
        const below = items.filter(
          (el) =>
            el.getBoundingClientRect().top > window.innerHeight ||
            (el instanceof HTMLImageElement && !el.complete),
        );
        below.forEach((el) => el.classList.add('reveal-pending'));

        const observer = new IntersectionObserver(
          (entries) => {
            const entering = entries.filter((e) => e.isIntersecting).map((e) => e.target as HTMLElement);

            entering.forEach((el, i) => {
              observer.unobserve(el);
              const go = () => reveal(el, Math.min(i, 5) * STAGGER_MS);

              // Wait for photos to load, so they fade in rather than fade in empty and then pop
              const img = el instanceof HTMLImageElement ? el : el.querySelector('img');
              if (img && !img.complete) {
                img.addEventListener('load', go, { once: true });
                img.addEventListener('error', go, { once: true });
              } else {
                go();
              }
            });
          },
          { rootMargin: '0px 0px -40px 0px' },
        );

        below.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>

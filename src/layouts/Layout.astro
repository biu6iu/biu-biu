---
import Nav from '../components/Nav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  center?: boolean;
}

const { title, center = false } = Astro.props;

const base = import.meta.env.BASE_URL;

const mainClass = [
  'flex-1 overflow-y-auto h-screen max-md:h-auto max-md:min-h-0 box-border p-5',
  center ? 'flex justify-center items-center text-center' : '',
].join(' ');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <script is:inline>
      if (localStorage.getItem('theme') === 'dark') {
        document.documentElement.classList.add('dark-mode');
      }
    </script>
  </head>
  <body class="m-0 p-0 font-serif text-ink bg-page flex h-screen">
    <div class="flex max-md:flex-col w-full min-h-screen max-md:h-auto overflow-hidden">
      <Nav />
      <main class={mainClass}>
        <slot />
      </main>
    </div>
  </body>
</html>

---
// The left-pointing chevron on the nav toggle and the photo strip controls; rotate it to point elsewhere

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.25"
  stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
  class:list={['block', className]}
>
  <polyline points="11,4 6,9 11,14" />
</svg>

---
import type { Project } from '../data/projects.ts';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<li class="border-b border-line">
  <a
    href={`${base}projects/${project.slug}`}
    class="block no-underline py-3
           transition-opacity duration-300 ease-[ease] motion-reduce:transition-none
           group-hover/list:opacity-40 hover:opacity-100! focus-visible:opacity-100!"
  >
    <h3 class="text-base font-medium text-ink">{project.title}</h3>
    <p class="text-ink-muted text-xs mt-1">{project.summary}</p>
  </a>
</li>

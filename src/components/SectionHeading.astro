---
// Section <h2>, used across the about, projects, contact and collections pages.
// Styled like the STEVEN LU wordmark in the nav and centred like the collection titles;
// `sub` is the smaller, left-aligned version for sections within a page.

interface Props {
  sub?: boolean;
}

const { sub = false } = Astro.props;
---

<h2
  data-reveal
  class:list={[
    'uppercase',
    sub ? 'font-medium text-[18px] max-md:text-[16px] mb-4' : 'font-normal text-[24px] max-md:text-[20px] mb-6 text-center',
  ]}
>
  <slot />
</h2>

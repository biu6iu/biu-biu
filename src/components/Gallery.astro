---
import type { Gallery } from '../data/galleries.ts';
import CollectionTitle from './CollectionTitle.astro';
import PhotoStrip from './PhotoStrip.astro';

interface Props {
  gallery: Gallery;
}

const { gallery } = Astro.props;
---

<PhotoStrip items={gallery.images} label={`${gallery.title} photos`}>
  <CollectionTitle>{gallery.title}</CollectionTitle>
</PhotoStrip>

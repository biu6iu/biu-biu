---
// A sideways strip that settles on one photo at a time, used by the photography index and each collection.
// The centred photo is full strength and the others fade with their distance from the centre.

export interface StripItem {
  src: string;
  alt: string;
  /** Original pixel size; only the ratio matters, it reserves the photo's space before it loads */
  width: number;
  height: number;
  /** When set, the item is a link: clicking it while centred opens it */
  href?: string;
  /** Shown under the strip while this item is centred */
  caption?: string;
}

interface Props {
  items: StripItem[];
  /** Accessible name for the strip, e.g. "Sydney photos" */
  label: string;
}

const { items, label } = Astro.props;
const count = items.length;
const hasCaptions = items.some((item) => item.caption);

const controlClass =
  'p-1.5 border-0 bg-transparent cursor-pointer rounded-md text-ink-muted hover:text-ink ' +
  'disabled:opacity-30 disabled:cursor-default disabled:hover:text-ink-muted ' +
  'transition-[color,scale] duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] active:scale-[0.97]';

const itemClass = 'block shrink-0 w-auto snap-center opacity-(--fade) cursor-pointer data-current:cursor-default';

// Same size rule as the home page slideshow (index.astro): at most 75% of the main area wide and 75% of
// the screen tall. cqw is a percentage of the strip, which spans the main area like the slideshow does.
const itemStyle = (item: StripItem, i: number) =>
  `--fade: ${i === 0 ? 1 : 0.5}; aspect-ratio: ${item.width} / ${item.height}; ` +
  `height: min(75svh, calc(75cqw * ${item.height / item.width}));`;
---

<!-- Three rows: the slot (page title), the strip, the caption and controls. The outer rows share the
     leftover height equally, so the strip, and the photo centred in it, sits in the middle of the main
     area like the home page slideshow. Where the page scrolls (phones), the rows just stack. -->
<div class="@container grid grid-rows-[minmax(0,1fr)_auto_minmax(0,1fr)] w-full h-full min-w-0" data-strip>
  <div class="self-start w-full">
    <slot />
  </div>

  <div
    class:list={[
      'strip-track relative flex items-center gap-6 max-md:gap-3 px-[12.5cqw] overflow-x-auto overscroll-x-contain',
      'snap-x snap-mandatory [scrollbar-width:none] [&::-webkit-scrollbar]:hidden',
      'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink-muted',
    ]}
    tabindex="0"
    role="region"
    aria-label={`${label}. Use the arrow keys to move between photos.`}
  >
    {items.map((item, i) => {
      const loading = i < 2 ? 'eager' : 'lazy';
      const current = i === 0 ? '' : undefined;
      return item.href ? (
        <a
          href={item.href}
          data-strip-item
          data-caption={item.caption}
          data-reveal
          data-current={current}
          class={itemClass}
          style={itemStyle(item, i)}
        >
          <img src={item.src} alt={item.alt} width={item.width} height={item.height} loading={loading} class="block w-full h-full" />
        </a>
      ) : (
        <img
          src={item.src}
          alt={item.alt}
          width={item.width}
          height={item.height}
          loading={loading}
          data-strip-item
          data-caption={item.caption}
          data-reveal
          data-current={current}
          class={itemClass}
          style={itemStyle(item, i)}
        />
      );
    })}
  </div>

  <div class="self-start">
    {hasCaptions && (
      <p data-strip-caption class="m-0 mt-5 text-center text-base text-ink" aria-live="polite">{items[0].caption}</p>
    )}

    <div class:list={['flex justify-center items-center gap-6 text-sm text-ink-muted', hasCaptions ? 'mt-2' : 'mt-5']}>
      <button type="button" data-prev aria-label="Previous" class={controlClass} disabled>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="block">
          <polyline points="11,4 6,9 11,14" />
        </svg>
      </button>
      <span data-counter class="min-w-[5ch] text-center tabular-nums">1 / {count}</span>
      <button type="button" data-next aria-label="Next" class={controlClass} disabled={count < 2}>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="block rotate-180">
          <polyline points="11,4 6,9 11,14" />
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  // Trackpads send a stream of wheel events per gesture; a gap longer than this starts a new one
  const GESTURE_GAP_MS = 180;
  // Minimum time between moves, roughly the length of the smooth scroll
  const MOVE_COOLDOWN_MS = 350;
  // Opacity of an item one step or more from the centre
  const DIMMED_OPACITY = 0.5;

  document.querySelectorAll<HTMLElement>('[data-strip]').forEach((root) => {
    const strip = root.querySelector<HTMLElement>('.strip-track')!;
    const items = Array.from(strip.querySelectorAll<HTMLElement>('[data-strip-item]'));
    const caption = root.querySelector<HTMLElement>('[data-strip-caption]');
    const counter = root.querySelector<HTMLElement>('[data-counter]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let current = 0;
    let lastWheel = 0;
    let busyUntil = 0;

    // Scroll position that centres an item, clamped to what the strip can actually reach at either end
    const targetOf = (item: HTMLElement) =>
      Math.max(0, Math.min(strip.scrollWidth - strip.clientWidth, item.offsetLeft + item.offsetWidth / 2 - strip.clientWidth / 2));

    // Opacity follows each item's distance from its centred position on every frame, so the incoming
    // item brightens as it travels in and the outgoing one fades as it leaves. Set through --fade so the
    // scroll reveal (global.css) can still hide a photo that hasn't loaded.
    const paintFades = () => {
      items.forEach((item) => {
        const distance = Math.min(1, Math.abs(targetOf(item) - strip.scrollLeft) / item.offsetWidth);
        item.style.setProperty('--fade', String(1 - (1 - DIMMED_OPACITY) * distance));
      });
    };

    const goTo = (index: number) => {
      current = Math.max(0, Math.min(items.length - 1, index));
      strip.scrollTo({ left: targetOf(items[current]), behavior: reduceMotion ? 'auto' : 'smooth' });
      render();
    };

    const render = () => {
      items.forEach((item, i) => item.toggleAttribute('data-current', i === current));
      if (caption) caption.textContent = items[current].dataset.caption ?? '';
      counter.textContent = `${current + 1} / ${items.length}`;
      prev.disabled = current === 0;
      next.disabled = current === items.length - 1;
    };

    // Keep the fades, caption and counter right however the strip was moved (swipe, scrollbar, snap)
    let frame = 0;
    const onMove = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        paintFades();
        let nearest = 0;
        items.forEach((item, i) => {
          if (Math.abs(targetOf(item) - strip.scrollLeft) < Math.abs(targetOf(items[nearest]) - strip.scrollLeft)) nearest = i;
        });
        current = nearest;
        render();
      });
    };
    strip.addEventListener('scroll', onMove, { passive: true });
    window.addEventListener('resize', onMove);
    paintFades();

    // A vertical wheel or trackpad scroll moves one item per gesture
    strip.addEventListener(
      'wheel',
      (event) => {
        if (Math.abs(event.deltaX) > Math.abs(event.deltaY)) return; // sideways swipe: native scroll and snap

        const direction = Math.sign(event.deltaY);
        const target = current + direction;
        if (direction === 0 || target < 0 || target >= items.length) return; // at an end: let the page scroll

        event.preventDefault();
        const now = performance.now();
        const newGesture = now - lastWheel > GESTURE_GAP_MS;
        lastWheel = now;

        if (newGesture && now >= busyUntil) {
          busyUntil = now + MOVE_COOLDOWN_MS;
          goTo(target);
        }
      },
      { passive: false },
    );

    strip.addEventListener('keydown', (event) => {
      if (event.target !== strip) return; // Enter/arrows on a focused link inside behave normally
      if (event.key === 'ArrowRight') goTo(current + 1);
      else if (event.key === 'ArrowLeft') goTo(current - 1);
      else return;
      event.preventDefault();
    });

    // Clicking a dimmed neighbour brings it to the centre; clicking the centred item follows its link.
    // Keyboard activation (detail 0) always follows the link, since a tabbed-to item is the one wanted.
    items.forEach((item, i) =>
      item.addEventListener('click', (event) => {
        if (i === current || event.detail === 0) return;
        event.preventDefault();
        goTo(i);
      }),
    );

    prev.addEventListener('click', () => goTo(current - 1));
    next.addEventListener('click', () => goTo(current + 1));
  });
</script>

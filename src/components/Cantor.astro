---
// ASCII Cantor's diagonal argument for the contact page, styled like falling code. Rows of a list of
// binary sequences fall down the screen with their diagonal digits lit. As each row reaches the bottom,
// its diagonal digit is flipped and drops into a new row s beneath, which so differs from every row.
---

<div class="flex flex-col items-center" data-cantor>
  <pre aria-hidden="true" class="m-0 font-mono text-[13px] max-sm:text-[12px] leading-[1.3] text-ink-muted" data-cantor-grid></pre>
  <p class="m-0 mt-3 text-sm text-ink-muted text-center">cantor's diagonal argument</p>
</div>

<script>
  // Rows on screen at once; the bottom one is where diagonal digits are flipped into s
  const VISIBLE = 6;
  // Digits per row, as many as fit within these bounds; s is complete once it's as long as the rows shown
  const MIN_DIGITS = 10;
  const MAX_DIGITS = 20;
  const FALL_MS = 650;
  const END_PAUSE_MS = 4000;
  // Rows fade in towards the top, like falling code
  const TOP_OPACITY = 0.3;

  const ink = (text: string) => `<span class="text-ink">${text}</span>`;
  const randomDigits = (n: number) => Array.from({ length: n }, () => (Math.random() < 0.5 ? 0 : 1));

  document.querySelectorAll<HTMLElement>('[data-cantor]').forEach((root) => {
    const grid = root.querySelector<HTMLElement>('[data-cantor-grid]')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Digits are 2 columns apart; measure the font to see how many fit across
    grid.textContent = '0'.repeat(10);
    const charWidth = grid.getBoundingClientRect().width / 10;
    const fit = Math.floor((root.clientWidth / charWidth + 1) / 2);
    const digits = Math.max(MIN_DIGITS, Math.min(MAX_DIGITS, fit));

    let rows: number[][] = [];
    // The row at the bottom of the screen, counting from 0; rows above it are the ones that follow it
    let bottom = 0;

    const reset = () => {
      rows = Array.from({ length: digits + VISIBLE }, () => randomDigits(digits));
      bottom = 0;
    };

    const draw = () => {
      const lines: string[] = [];
      for (let k = bottom + VISIBLE - 1; k >= bottom; k--) {
        const cells = rows[k]
          .map((d, j) => {
            if (j !== k) return String(d);
            // The diagonal glints: lit all the way up, brightest where it's being flipped
            return k === bottom ? `<span class="text-ink font-medium">${d}</span>` : ink(String(d));
          })
          .join(' ');
        const opacity = 1 - ((1 - TOP_OPACITY) * (k - bottom)) / (VISIBLE - 1);
        lines.push(`<span style="opacity: ${opacity.toFixed(2)}">${cells}</span>`);
      }
      // s has one flipped digit for every row that has reached the bottom, each straight under its column
      const flipped = rows.slice(0, bottom + 1).map((row, i) => ink(String(1 - row[i])));
      lines.push('', flipped.join(' '));
      grid.innerHTML = lines.join('\n');
    };

    reset();

    if (reduceMotion) {
      bottom = digits - 1;
      draw();
      return;
    }

    // Runs on its own clock, which only moves while it's on screen, so it resumes where it was
    let clock = 0;
    let nextAt = FALL_MS * 2;
    let frame = 0;
    let last = 0;
    const tick = (now: number) => {
      clock += Math.min(100, now - last);
      last = now;
      let changed = false;
      while (clock >= nextAt) {
        if (bottom === digits - 1) reset();
        else bottom++;
        nextAt += bottom === digits - 1 ? END_PAUSE_MS : FALL_MS;
        changed = true;
      }
      if (changed) draw();
      frame = requestAnimationFrame(tick);
    };

    draw();
    new IntersectionObserver(([entry]) => {
      cancelAnimationFrame(frame);
      if (entry.isIntersecting) {
        last = performance.now();
        frame = requestAnimationFrame(tick);
      }
    }).observe(root);
  });
</script>

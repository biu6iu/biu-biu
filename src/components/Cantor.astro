---
// ASCII Cantor's diagonal argument for the contact page. A list of infinite binary sequences is shown with
// its diagonal in black; one by one the diagonal digits are flipped to build a new sequence s underneath,
// which so differs from every sequence in the list at its diagonal digit, and the list can't hold them all.
// Between rounds the grid fades out and back in with new sequences.
import AsciiFigure from './AsciiFigure.astro';
---

<AsciiFigure
  name="cantor"
  caption="cantor's diagonal argument"
  class="text-[13px] max-sm:text-[12px] leading-[1.3] transition-opacity duration-500"
/>

<script>
  import { antidiagonal, randomSequences } from '../lib/cantor.ts';
  import { ink } from '../lib/ascii.ts';
  import { fadeBetweenRounds, playSteps, prefersReducedMotion } from '../lib/motion.ts';

  // A square: each sequence shows as many digits as there are sequences, so s, built from the diagonal,
  // is exactly as long as the rows above it
  const SEQUENCES = 6;
  // Each diagonal digit is picked out, then its flip drops into s
  const LIGHT_MS = 700;
  const DROP_MS = 600;
  const START_PAUSE_MS = 1200;
  const END_PAUSE_MS = 3000;
  // Matches the <pre>'s opacity transition
  const FADE_MS = 500;

  const SUBSCRIPT = '₀₁₂₃₄₅₆₇₈₉';
  const sub = (n: number) => [...String(n)].map((d) => SUBSCRIPT[Number(d)]).join('');

  document.querySelectorAll<HTMLElement>('[data-cantor]').forEach((root) => {
    const grid = root.querySelector<HTMLElement>('[data-ascii-grid]')!;

    let rows: number[][] = [];
    let escape: number[] = [];
    // Diagonal digits picked out so far, and digits of s written so far
    let lit = 0;
    let built = 0;

    const reset = () => {
      rows = randomSequences(SEQUENCES, SEQUENCES);
      escape = antidiagonal(rows);
      lit = built = 0;
    };

    // The next beat and how long it lasts, or null once s is complete
    const advance = (): number | null => {
      if (built < lit) {
        built++;
        return built === SEQUENCES ? END_PAUSE_MS : DROP_MS;
      }
      if (lit < SEQUENCES) {
        lit++;
        return LIGHT_MS;
      }
      return null;
    };

    // The diagonal and s are in black; everything else keeps the grey of the <pre>
    const draw = () => {
      // The digit being flipped is bracketed
      const current = lit > built ? lit - 1 : -1;
      const lines = rows.map((row, i) => {
        const cells = row
          .map((d, j) => {
            if (j !== i) return ` ${d} `;
            return i === current ? ink(`[${d}]`) : ` ${ink(String(d))} `;
          })
          .join('');
        return `s${sub(i + 1)} = ${cells} …`;
      });
      const flipped = escape.slice(0, built).map((d) => ` ${ink(String(d))} `).join('');
      lines.push('', ` s = ${flipped}${built ? ' …' : ''}`);
      grid.innerHTML = lines.join('\n');
    };

    reset();

    if (prefersReducedMotion()) {
      while (advance() !== null);
      draw();
      return;
    }

    // Once s is complete the grid fades out, swaps in new sequences while hidden, and fades back in
    const step = fadeBetweenRounds(grid, FADE_MS, advance, () => {
      reset();
      return START_PAUSE_MS;
    });

    draw();
    playSteps(root, START_PAUSE_MS, step, draw);
  });
</script>

---
import type { Collection } from '../data/collections.ts';

interface Props {
  collection: Collection;
}

const { collection } = Astro.props;

const slug = collection.path.replace(/\.html$/, '');
const href = `${import.meta.env.BASE_URL}collections/${slug}`;
---

<a
  href={href}
  class="block transition-transform duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] active:scale-[0.97]"
>
  <img
    src={collection.coverImage}
    alt={collection.title}
    class="block w-full h-auto max-w-131.25 max-md:max-w-full max-h-131.25 object-cover"
  />
</a>

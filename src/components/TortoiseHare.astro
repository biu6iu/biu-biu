---
// ASCII Floyd's cycle detection for the projects page. A linked list runs into a loop; the tortoise moves
// one node at a time and the hare two, until they meet inside the loop. The tortoise then goes back to the
// head and both move one node at a time, meeting again where the loop starts. Then the drawing fades out
// and back in with a new list.
import AsciiFigure from './AsciiFigure.astro';
---

<AsciiFigure
  name="floyd"
  caption="floyd's cycle detection"
  class="text-[13px] max-sm:text-[12px] leading-[1.15] transition-opacity duration-500"
/>

<script>
  import { floyd, type FloydPhase, type FloydStep } from '../lib/floyd.ts';
  import { charWidth, gridToHtml } from '../lib/ascii.ts';
  import { fadeBetweenRounds, playSteps, prefersReducedMotion, randomInt } from '../lib/motion.ts';

  // Nodes sit 4 columns apart: "o---o"
  const SPACING = 4;
  const ROWS = 5; // the loop's top row, its two diagonals, the tail's row through its middle, its bottom row
  const TAIL_ROW = 2;
  // Nodes before the loop, and nodes along the loop's top (and bottom) edge, picked at random in these bounds
  const MIN_TAIL = 2;
  const MAX_TAIL = 6;
  const MIN_EDGE = 2;
  const MAX_EDGE = 7;
  // The hare hops every tick while chasing; once the tortoise restarts, both move every other tick
  const TICK_MS = 260;
  // How long each step stays on screen, by its phase
  const HOLD_MS: Record<FloydPhase, number> = {
    start: TICK_MS * 2,
    chase: TICK_MS,
    met: 1400,
    restart: TICK_MS * 2,
    found: 3000,
  };
  // Matches the <pre>'s opacity transition
  const FADE_MS = 500;

  document.querySelectorAll<HTMLElement>('[data-floyd]').forEach((root) => {
    const grid = root.querySelector<HTMLElement>('[data-ascii-grid]')!;
    const maxNodesAcross = Math.floor((root.clientWidth / charWidth(grid) - 1) / SPACING);

    let tail = 0; // nodes 0 .. tail-1 lead to the loop, node `tail` is where it starts
    let edge = 0;
    let cols = 0;
    let positions: { x: number; y: number }[] = [];
    let steps: FloydStep[] = [];
    let current = 0; // the step on screen

    // The loop goes clockwise from where the tail joins it: up a diagonal, along the top, down to its
    // far end, back along the bottom and up into the start again
    const newList = () => {
      tail = randomInt(MIN_TAIL, MAX_TAIL);
      edge = randomInt(MIN_EDGE, MAX_EDGE);
      // Shrink whichever part is longer until it fits
      while (tail + edge > maxNodesAcross && tail + edge > MIN_TAIL + MIN_EDGE) {
        if (tail > MIN_TAIL && (tail >= edge || edge === MIN_EDGE)) tail--;
        else edge--;
      }
      const start = tail * SPACING;
      cols = start + edge * SPACING + 1;

      positions = [];
      for (let i = 0; i <= tail; i++) positions.push({ x: i * SPACING, y: TAIL_ROW });
      for (let j = 0; j < edge; j++) positions.push({ x: start + 2 + j * SPACING, y: 0 });
      positions.push({ x: start + edge * SPACING, y: TAIL_ROW });
      for (let j = edge - 1; j >= 0; j--) positions.push({ x: start + 2 + j * SPACING, y: ROWS - 1 });

      steps = floyd({ tail, loop: 2 * edge + 2 });
      current = 0;
    };

    const draw = () => {
      const chars = Array.from({ length: ROWS }, () => Array<string>(cols).fill(' '));
      const ink = Array.from({ length: ROWS }, () => Array<boolean>(cols).fill(false));
      const start = tail * SPACING;
      const far = start + edge * SPACING;

      for (let x = 0; x < start; x++) chars[TAIL_ROW][x] = '-';
      for (let x = start + 2; x < far - 1; x++) chars[0][x] = chars[ROWS - 1][x] = '-';
      chars[1][start + 1] = '/';
      chars[3][start + 1] = '\\';
      chars[1][far - 1] = '\\';
      chars[3][far - 1] = '/';
      positions.forEach(({ x, y }) => (chars[y][x] = 'o'));

      // Together they're drawn as one mark
      const mark = (node: number, c: string) => {
        const { x, y } = positions[node];
        chars[y][x] = c;
        ink[y][x] = true;
      };
      const { phase, tortoise, hare } = steps[current];
      if (tortoise === hare) mark(tortoise, phase === 'found' ? '@' : '*');
      else {
        mark(tortoise, 'T');
        mark(hare, 'H');
      }

      grid.innerHTML = gridToHtml(chars, ink);
    };

    newList();

    if (prefersReducedMotion()) {
      // Show the answer: both pointers on the node where the loop starts
      current = steps.length - 1;
      draw();
      return;
    }

    // Moves on to the next step and returns how long it stays on screen. After the last step the drawing
    // fades out, swaps in a new list while hidden, and fades back in.
    const advance = fadeBetweenRounds(
      grid,
      FADE_MS,
      () => (current === steps.length - 1 ? null : HOLD_MS[steps[++current].phase]),
      () => {
        newList();
        return HOLD_MS.start;
      },
    );

    draw();
    playSteps(root, HOLD_MS.start, advance, draw);
  });
</script>
